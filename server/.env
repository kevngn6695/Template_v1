# =============================================================================
#  Template_v1 — server environment
# =============================================================================
#
#  SETUP
#    cp .env.example .env
#    npm run db:status          # fails fast and names anything missing
#
#  This file is committed. `.env` is NOT — it is in .gitignore. Never put a
#  real password, key or token in this file; keep the placeholders.
#
#  Every variable below is read and validated once, in src/config/env.config.ts.
#  A missing or malformed value stops the process at boot with the name of the
#  offending variable, rather than surfacing later as a confusing auth error.
#
#  SYNTAX RULES THAT ACTUALLY BITE
#    • An unquoted `#` starts a comment mid-line. `PASS=pa#ss` parses as `pa`.
#      Quote any value containing `#`.
#    • Do not put spaces around `=`.
#    • Trailing whitespace is trimmed; quotes are stripped.
#    • `!` and `$` are safe unquoted — this file is not run by a shell, and
#      dotenv does not expand `$VAR`.
#    • Only inside "double quotes" does `\n` become a real newline. Single
#      quotes and no quotes keep it literal.
#
# =============================================================================
 
 
# --- Runtime -----------------------------------------------------------------
 
# development | test | production
NODE_ENV=development

# Origin of the front end, used for CORS. Must be a full URL with scheme.
# Optional — localhost:3000 and localhost:5173 are always allowed.
FRONTEND_URL=http://localhost:3000

# Port the API listens on.
PORT=5000


# Origin of the front end, used for CORS. Must be a full URL with scheme.
# Optional — localhost:3000 and localhost:5173 are always allowed.
FRONTEND_URL=http://localhost:3000
 
 
# --- Postgres — REQUIRED -----------------------------------------------------
# The server will not start without all five of these.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=kevroo
DB_USER=kevroo

# Quote this if it contains `#`. Anything else is fine unquoted.
DB_PASSWORD=kevngn0606!

# Force TLS outside production too (a managed instance in staging, say).
# Certificate verification is ALWAYS on — there is no switch to disable it,
# because accepting any certificate lets an interceptor read every query.
DB_SSL=false

# Only needed when your provider's CA is not in the system trust store.
# A PEM is multi-line, so it must be in double quotes with \n separators:
# DB_SSL_CA="-----BEGIN CERTIFICATE-----\nMIIC...\n-----END CERTIFICATE-----"

# --- Secrets — REQUIRED ------------------------------------------------------
#
# Generate a fresh one for EACH of these, and a different set per environment:
#
#     node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
#
# In production these must be at least 32 characters and must not look like a
# placeholder — a value starting with `your_`, `changeme`, `example`, or
# containing `change_in_production`, is rejected at boot. In development
# anything non-empty is accepted so you can get running quickly.
 
SESSION_SECRET=change_me_run_the_command_above
COOKIE_SECRET=change_me_run_the_command_above

# Leave UNSET unless you are genuinely sharing cookies across subdomains.
# It must be a real hostname. `COOKIE_DOMAIN=cookie_domain` is silently fatal:
# the browser rejects the Set-Cookie and every request arrives with no session,
# with nothing in the logs to explain why.
# COOKIE_DOMAIN=.example.com
 
 
# --- Security ----------------------------------------------------------------
 
# bcrypt work factor, 10-15. Only relevant if you hash with bcrypt; the
# dependency review moved this project to argon2. Pick one hasher and delete
# the other — two ways to store a password is one way too many.
BCRYPT_ROUNDS=12
 
# Rate limiting on /api/auth. Window in milliseconds, then requests per window.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Cookie
COOKIE_SECRET=your_cookie_secret_change_in_production

# Admin
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=Admin@123

# --- First-run admin — optional, and safer left unset ------------------------
#
# Seeding an admin with a known password is one of the most common ways a
# deployment gets owned; `Admin@123` on a public host is found by scanners
# within hours. In production the password must be 16+ characters and may not
# start with "admin" or look like a placeholder.
#
# Prefer leaving both unset and creating the first admin through a one-time
# setup flow.
#
# DEFAULT_ADMIN_EMAIL=admin@example.com
# DEFAULT_ADMIN_PASSWORD=
 
 
# --- Logging -----------------------------------------------------------------
 
# pino levels: silent | fatal | error | warn | info | debug | trace
# NOT winston's set — `http`, `verbose` and `silly` will fail validation.
# Defaults to `info` in production, `debug` everywhere else.
LOG_LEVEL=debug
 
# Directory for error.log and combined.log. Defaults to ./logs.
# LOG_DIR=./logs
 