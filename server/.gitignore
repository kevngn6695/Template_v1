# --- Secrets -----------------------------------------------------------------
# .env holds a real database password and real signing keys. Committing it once
# means rotating everything in it, because git keeps history forever.
.env
.env.*
!.env.example

*.pem
*.key
*.p12
*.pfx

# --- Dependencies and build output -------------------------------------------
node_modules/
dist/
build/
coverage/
*.tsbuildinfo

# --- Logs --------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Editors and OS ----------------------------------------------------------
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# --- Caches ------------------------------------------------------------------
.eslintcache
.cache/
.tmp/